    <!-- https://nicholasph05.github.io/OntoAudit/ontologia#ProblemaAccesibilidad -->

    <owl:Class rdf:about="https://nicholasph05.github.io/OntoAudit/ontologia#ProblemaAccesibilidad">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nicholasph05.github.io/OntoAudit/ontologia#Problema"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://nicholasph05.github.io/OntoAudit/ontologia#incumplePractica"/>
                        <owl:someValuesFrom rdf:resource="https://nicholasph05.github.io/OntoAudit/ontologia#Accesibilidad"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nicholasph05.github.io/OntoAudit/ontologia#Problema"/>
    </owl:Class>
    


    <!-- https://nicholasph05.github.io/OntoAudit/ontologia#ProblemaRendimiento -->

