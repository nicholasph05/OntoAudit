                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://nicholasph05.github.io/OntoAudit/ontologia#tieneNivel"/>
                        <owl:hasValue rdf:resource="https://nicholasph05.github.io/OntoAudit/ontologia#Preventivo"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nicholasph05.github.io/OntoAudit/ontologia#SitioWeb"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://nicholasph05.github.io/OntoAudit/ontologia#tieneEstado"/>
                <owl:hasValue rdf:resource="https://nicholasph05.github.io/OntoAudit/ontologia#Aceptable"/>
            </owl:Restriction>
